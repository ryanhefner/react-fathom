# Fathom Analytics
# Get your site ID from https://app.usefathom.com → Settings → Site ID
NEXT_PUBLIC_FATHOM_SITE_ID=
NEXT_PUBLIC_FATHOM_CUSTOM_DOMAIN=cdn.usefathom.com
# Without a site ID the Event Stream uses a local-only client, not a DEMO embed.

# Site URL (for sitemap and canonical URLs)
SITE_URL=https://react-fathom.com

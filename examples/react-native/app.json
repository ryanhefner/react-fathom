{
  "expo": {
    "name": "react-fathom-example",
    "slug": "react-fathom-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reactfathom",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
